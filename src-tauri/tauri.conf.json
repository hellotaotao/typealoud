{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "TypeAloud",
  "version": "1.19.3",
  "identifier": "com.tao.typealoud",
  "build": {
    "frontendDist": "../src/views",
    "beforeDevCommand": null,
    "beforeBuildCommand": null
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "TypeAloud",
        "url": "main.html",
        "width": 1200,
        "height": 800,
        "minWidth": 700,
        "minHeight": 500,
        "visible": false,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      },
      {
        "label": "input-prompt",
        "title": "Voice Input",
        "url": "input-prompt.html",
        "width": 460,
        "height": 244,
        "visible": false,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "focus": false,
        "shadow": false
      },
      {
        "label": "ax-cloud",
        "url": "ax-cloud.html",
        "width": 200,
        "height": 230,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "focus": false,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "public.app-category.productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15.0",
      "signingIdentity": null,
      "hardenedRuntime": true,
      "entitlements": "../build/entitlements.mac.plist",
      "infoPlist": "Info.plist",
      "dmg": {
        "windowSize": {
          "width": 680,
          "height": 440
        },
        "appPosition": {
          "x": 210,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 470,
          "y": 170
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJFOUFGNjI3QTdFQjg0NwpSV1JIdUg1NllxL3BDenA2WExRcHJVOXMvSUF2cmwzMUZ2ZTB5NHZLTWJKMy9yMUtyenFncWtsNgo=",
      "endpoints": [
        "https://github.com/hellotaotao/typealoud/releases/latest/download/latest.json",
        "https://typealoud.app/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
